root = true

# O Biome cuida da formatação de TS/TSX/JSON/CSS. O que fica aqui é o que ele não
# cobre — e serve para editores sem plugin do Biome.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs,json,jsonc,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.prisma]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
