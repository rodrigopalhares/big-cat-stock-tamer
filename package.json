{
  "name": "stocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "esbuild src/client/*.ts --bundle --minify --outdir=public/js --format=iife",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check && eslint . && depcruise src && prisma validate",
    "format": "biome check --write",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "preact": "^10.29.7",
    "preact-render-to-string": "^6.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
