# Copie para .env e ajuste. Equivalente ao bloco `app:` do application.yml antigo.

# Diretório base de dados (banco SQLite + arquivo de sessão)
APP_DATA_DIR=./data

# Banco. Derivado de APP_DATA_DIR; o Prisma exige a variável explícita.
DATABASE_URL="file:./data/stocks.db"

PORT=8000
LOG_LEVEL=info

# Autenticação de usuário único. Em branco = autenticação desabilitada.
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_DAYS=365

# Backup automático do banco
APP_BACKUP_ENABLED=true
APP_BACKUP_DAILY_COPIES=7
APP_BACKUP_MONTHLY_COPIES=3
