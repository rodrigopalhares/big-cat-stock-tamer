# Copie para .env e ajuste. Tudo é validado no boot por src/config/env.ts — configuração
# errada derruba a aplicação com mensagem clara, em vez de virar undefined num request.
#
# Este arquivo é conveniência de desenvolvimento, não requisito: em produção as variáveis
# costumam vir direto do ambiente (Docker, systemd, CI) e nenhum .env precisa existir.

# development | test | production
NODE_ENV=development

PORT=8000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Diretório base: banco, backups e arquivo de sessão são derivados daqui.
APP_DATA_DIR=./data

# O Prisma exige a variável explícita, então este caminho não é derivado de APP_DATA_DIR:
# se mudar um, mude o outro.
DATABASE_URL="file:./data/stocks.db"

# Autenticação de usuário único. Em branco = autenticação desabilitada.
APP_AUTH_PASSWORD=
APP_AUTH_SESSION_DAYS=365

# Backup automático (VACUUM INTO ao subir e às 00:05 de America/Sao_Paulo).
APP_BACKUP_ENABLED=true
APP_BACKUP_DAILY_COPIES=7
APP_BACKUP_MONTHLY_COPIES=3

# Opcionais — descomente só para sair do padrão derivado de APP_DATA_DIR.
# APP_BACKUP_DIR=./data/backups
# APP_AUTH_KEY_FILE=./data/auth.key
